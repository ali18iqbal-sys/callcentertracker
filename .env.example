# ============================================================================
#  CallCenterTracker — environment configuration template
# ============================================================================
#  Copy this file to ".env" in the project root and fill in the values you
#  need. The real ".env" file is git-ignored and must never be committed.
#
#  Resolution order for every secret:
#      1. Environment variables (this file, or the OS environment)
#      2. Streamlit Secrets (.streamlit/secrets.toml — recommended for Cloud)
#      3. Values stored with the data source itself (development convenience)
#
#  Run "python -c \"from app.utils import secrets; print(secrets.load_env_file())\""
#  to verify that this file is being picked up.
# ============================================================================

# ── Application ─────────────────────────────────────────────────────────────
# Deployment label shown in the sidebar (development | staging | production)
APP_ENV=development

# ── Ringba API (Data Sources → Ringba) ──────────────────────────────────────
# Leave these blank to enter credentials through the UI instead.
# RINGBA_ACCOUNT_ID=
# RINGBA_API_TOKEN=

# ── Google Sheets service account (Data Sources → Google Sheets) ───────────
# Absolute or project-relative path to the service-account JSON key.
# GOOGLE_APPLICATION_CREDENTIALS=creds/service_account.json

# ── Generic API sources (Data Sources → APIs) ───────────────────────────────
# Fallback token when a source is configured with bearer/api_key auth but has
# no credential stored against it.
# API_TOKEN=

# ── Authentication ──────────────────────────────────────────────────────────
# Session cookie signing key. Strongly recommended for production: leaving it
# blank falls back to the value configured in users.yaml / Streamlit Secrets.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# CCT_COOKIE_KEY=